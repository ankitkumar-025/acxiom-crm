<div style="margin-bottom: 20px;">
  <a href="/reports" style="color: var(--text-dim); text-decoration: none; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 6px;">
    <i class="fa-solid fa-arrow-left"></i>
    <span>Back to Reports Hub</span>
  </a>
</div>

<div class="glass-card">
  <div class="card-header-flex">
    <div>
      <h2 style="font-size: 1.3rem; font-weight: 800; color: #fff; margin: 0 0 4px;"><%= reportTitle %></h2>
      <p style="margin: 0; font-size: 0.85rem; color: var(--text-muted);">
        Generated on <%= new Date().toLocaleDateString() %> &bull; Scoped to <%= currentUser.role %> view
      </p>
    </div>
    <div style="display: flex; gap: 10px;">
      <a href="/reports/<%= reportType %>/export" class="btn-crm btn-crm-primary btn-crm-sm">
        <i class="fa-solid fa-file-csv"></i>
        <span>Download CSV</span>
      </a>
      <button onclick="window.print()" class="btn-crm btn-crm-secondary btn-crm-sm">
        <i class="fa-solid fa-print"></i>
        <span>Print</span>
      </button>
    </div>
  </div>

  <% if (reportType === 'pipeline') { %>
    <!-- Special Layout for Pipeline Report: Stage-wise & Owner-wise Breakdown -->
    <div style="margin-bottom: 30px;">
      <h3 class="card-title" style="margin-bottom: 14px; font-size: 1.05rem;">
        <i class="fa-solid fa-layer-group text-primary"></i> Stage-Wise Pipeline Volume
      </h3>
      <table class="crm-table">
        <thead>
          <tr>
            <th>Stage</th>
            <th>Deals Count</th>
            <th>Total Deal Amount</th>
            <th>Weighted Forecast (Amount × Prob / 100)</th>
          </tr>
        </thead>
        <tbody>
          <% reportData.stageData.forEach(s => { %>
            <tr>
              <td><span class="user-role-badge"><%= s.Stage %></span></td>
              <td><%= s.OpportunityCount %></td>
              <td><strong>$<%= Number(s.TotalAmount).toLocaleString() %></strong></td>
              <td style="color: #34d399; font-weight: 700;">$<%= Number(s.WeightedPipeline).toLocaleString() %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div>
      <h3 class="card-title" style="margin-bottom: 14px; font-size: 1.05rem;">
        <i class="fa-solid fa-user-tie text-info"></i> Owner-Wise Deal Distribution
      </h3>
      <table class="crm-table">
        <thead>
          <tr>
            <th>Representative</th>
            <th>Deals Count</th>
            <th>Total Deal Amount</th>
            <th>Weighted Forecast</th>
          </tr>
        </thead>
        <tbody>
          <% reportData.ownerData.forEach(o => { %>
            <tr>
              <td><strong><%= o.OwnerName %></strong></td>
              <td><%= o.OpportunityCount %></td>
              <td><strong>$<%= Number(o.TotalAmount).toLocaleString() %></strong></td>
              <td style="color: #34d399; font-weight: 700;">$<%= Number(o.WeightedPipeline).toLocaleString() %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

  <% } else if (reportData && reportData.length > 0) { %>
    <!-- Generic Table Display for Reports -->
    <% const headers = Object.keys(reportData[0]); %>
    <div style="overflow-x: auto;">
      <table class="crm-table">
        <thead>
          <tr>
            <% headers.forEach(h => { %>
              <th><%= h.replace(/([A-Z])/g, ' $1').trim() %></th>
            <% }); %>
          </tr>
        </thead>
        <tbody>
          <% reportData.forEach(row => { %>
            <tr>
              <% headers.forEach(h => { %>
                <td>
                  <% if (typeof row[h] === 'number') { %>
                    <%= (h.toLowerCase().includes('amount') || h.toLowerCase().includes('value') || h.toLowerCase().includes('weighted')) ? '$' + Number(row[h]).toLocaleString() : row[h] %>
                  <% } else { %>
                    <%= row[h] || '—' %>
                  <% } %>
                </td>
              <% }); %>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div style="margin-top: 16px; font-size: 0.85rem; color: var(--text-dim); text-align: right;">
      Total Records: <strong><%= reportData.length %></strong>
    </div>

  <% } else { %>
    <div style="text-align: center; padding: 50px; color: var(--text-dim);">
      <i class="fa-regular fa-folder-open" style="font-size: 2.5rem; margin-bottom: 12px; display: block;"></i>
      No data available for this report criteria.
    </div>
  <% } %>
</div>
