<div style="max-width: 600px; margin: 60px auto; text-align: center;">
  <div class="glass-card" style="padding: 40px;">
    <div style="font-size: 3.5rem; color: var(--secondary); margin-bottom: 16px;">
      <i class="fa-solid fa-compass-drafting"></i>
    </div>
    <h2 style="font-size: 1.8rem; font-weight: 800; color: #fff; margin: 0 0 10px;">404 Page Not Found</h2>
    <p style="font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; margin: 0 0 24px;">
      <%= typeof message !== 'undefined' ? message : 'The CRM page or record you requested does not exist.' %>
    </p>
    <a href="/dashboard" class="btn-crm btn-crm-primary">
      <i class="fa-solid fa-house"></i>
      <span>Return to Dashboard</span>
    </a>
  </div>
</div>
