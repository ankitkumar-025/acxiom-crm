<div style="max-width: 900px; margin: 0 auto;">
  <div style="margin-bottom: 20px;">
    <a href="/customers/<%= customer.CustomerId %>" style="color: var(--text-dim); text-decoration: none; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 6px;">
      <i class="fa-solid fa-arrow-left"></i>
      <span>Back to Customer Details</span>
    </a>
  </div>

  <div class="glass-card">
    <div class="card-header-flex">
      <div>
        <h2 style="font-size: 1.3rem; font-weight: 800; color: #fff; margin: 0 0 4px;">Edit Customer: <%= customer.CustomerName %></h2>
        <p style="margin: 0; font-size: 0.85rem; color: var(--text-muted);"><%= customer.CustomerCode %></p>
      </div>
    </div>

    <form action="/customers/<%= customer.CustomerId %>/edit" method="POST" class="needs-crm-validation">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 20px;">
        <div>
          <label class="form-label" for="CustomerName">Customer Name <span class="text-danger">*</span></label>
          <input type="text" id="CustomerName" name="CustomerName" class="form-control-crm" value="<%= customer.CustomerName %>" required maxlength="100" data-name="Customer Name">
        </div>

        <div>
          <label class="form-label" for="CompanyName">Company</label>
          <input type="text" id="CompanyName" name="CompanyName" class="form-control-crm" value="<%= customer.CompanyName || '' %>">
        </div>

        <div>
          <label class="form-label" for="Email">Email Address <span class="text-danger">*</span></label>
          <input type="email" id="Email" name="Email" class="form-control-crm" value="<%= customer.Email %>" required data-name="Email">
        </div>

        <div>
          <label class="form-label" for="Phone">Mobile Phone (10 Digits) <span class="text-danger">*</span></label>
          <input type="text" id="Phone" name="Phone" class="form-control-crm" value="<%= customer.Phone %>" required data-type="phone" data-name="Phone">
        </div>

        <div>
          <label class="form-label" for="City">City</label>
          <input type="text" id="City" name="City" class="form-control-crm" value="<%= customer.City || '' %>">
        </div>

        <div>
          <label class="form-label" for="State">State / Region</label>
          <input type="text" id="State" name="State" class="form-control-crm" value="<%= customer.State || '' %>">
        </div>

        <div>
          <label class="form-label" for="Status">Status</label>
          <select id="Status" name="Status" class="form-control-crm">
            <option value="Active" <%= customer.Status === 'Active' ? 'selected' : '' %>>Active</option>
            <option value="Inactive" <%= customer.Status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
          </select>
        </div>

        <% if (currentUser && (currentUser.role === 'Admin' || currentUser.role === 'Manager')) { %>
          <div>
            <label class="form-label" for="CreatedBy">Assigned Owner</label>
            <select id="CreatedBy" name="CreatedBy" class="form-control-crm">
              <% salesUsers.forEach(u => { %>
                <option value="<%= u.UserId %>" <%= customer.CreatedBy == u.UserId ? 'selected' : '' %>>
                  <%= u.Name %> (<%= u.Email %>)
                </option>
              <% }); %>
            </select>
          </div>
        <% } %>
      </div>

      <div style="margin-bottom: 24px;">
        <label class="form-label" for="Address">Address</label>
        <textarea id="Address" name="Address" rows="2" class="form-control-crm"><%= customer.Address || '' %></textarea>
      </div>

      <div style="display: flex; gap: 12px; justify-content: flex-end;">
        <a href="/customers/<%= customer.CustomerId %>" class="btn-crm btn-crm-secondary">Cancel</a>
        <button type="submit" class="btn-crm btn-crm-primary">
          <i class="fa-solid fa-check"></i>
          <span>Save Changes</span>
        </button>
      </div>
    </form>
  </div>
</div>
