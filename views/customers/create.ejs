<div style="max-width: 900px; margin: 0 auto;">
  <div style="margin-bottom: 20px;">
    <a href="/customers" style="color: var(--text-dim); text-decoration: none; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 6px;">
      <i class="fa-solid fa-arrow-left"></i>
      <span>Back to Customers</span>
    </a>
  </div>

  <div class="glass-card">
    <div class="card-header-flex">
      <div>
        <h2 style="font-size: 1.3rem; font-weight: 800; color: #fff; margin: 0 0 4px;">New Customer Account</h2>
        <p style="margin: 0; font-size: 0.85rem; color: var(--text-muted);">Enter master contact and organization details</p>
      </div>
      <span style="font-size: 0.75rem; color: var(--text-dim);"><i class="fa-solid fa-asterisk text-danger"></i> Required fields</span>
    </div>

    <form action="/customers/create" method="POST" class="needs-crm-validation">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 20px;">
        <!-- Customer Name -->
        <div>
          <label class="form-label" for="CustomerName">Customer / Contact Name <span class="text-danger">*</span></label>
          <input type="text" id="CustomerName" name="CustomerName" class="form-control-crm" placeholder="Acme Global Corporation" value="<%= typeof data !== 'undefined' && data.CustomerName ? data.CustomerName : '' %>" required maxlength="100" data-name="Customer Name">
        </div>

        <!-- Company Name -->
        <div>
          <label class="form-label" for="CompanyName">Company / Organization</label>
          <input type="text" id="CompanyName" name="CompanyName" class="form-control-crm" placeholder="Acme Holdings Pvt Ltd" value="<%= typeof data !== 'undefined' && data.CompanyName ? data.CompanyName : '' %>">
        </div>

        <!-- Email -->
        <div>
          <label class="form-label" for="Email">Email Address <span class="text-danger">*</span></label>
          <input type="email" id="Email" name="Email" class="form-control-crm" placeholder="contact@acme.com" value="<%= typeof data !== 'undefined' && data.Email ? data.Email : '' %>" required data-name="Email">
          <span style="font-size: 0.75rem; color: var(--text-dim);">Must be unique across customer records</span>
        </div>

        <!-- Phone -->
        <div>
          <label class="form-label" for="Phone">Mobile Phone (10 Digits) <span class="text-danger">*</span></label>
          <input type="text" id="Phone" name="Phone" class="form-control-crm" placeholder="9876543210" value="<%= typeof data !== 'undefined' && data.Phone ? data.Phone : '' %>" required data-type="phone" data-name="Phone">
          <span style="font-size: 0.75rem; color: var(--text-dim);">Must be unique 10-digit number</span>
        </div>

        <!-- City -->
        <div>
          <label class="form-label" for="City">City</label>
          <input type="text" id="City" name="City" class="form-control-crm" placeholder="Mumbai" value="<%= typeof data !== 'undefined' && data.City ? data.City : '' %>">
        </div>

        <!-- State -->
        <div>
          <label class="form-label" for="State">State / Region</label>
          <input type="text" id="State" name="State" class="form-control-crm" placeholder="Maharashtra" value="<%= typeof data !== 'undefined' && data.State ? data.State : '' %>">
        </div>

        <!-- Status -->
        <div>
          <label class="form-label" for="Status">Account Status</label>
          <select id="Status" name="Status" class="form-control-crm">
            <option value="Active" selected>Active</option>
            <option value="Inactive">Inactive</option>
          </select>
        </div>

        <!-- Assigned Sales Executive -->
        <% if (currentUser && (currentUser.role === 'Admin' || currentUser.role === 'Manager')) { %>
          <div>
            <label class="form-label" for="CreatedBy">Assigned Sales Executive</label>
            <select id="CreatedBy" name="CreatedBy" class="form-control-crm">
              <% salesUsers.forEach(u => { %>
                <option value="<%= u.UserId %>" <%= (typeof data !== 'undefined' && data.CreatedBy == u.UserId) ? 'selected' : '' %>>
                  <%= u.Name %> (<%= u.Email %>)
                </option>
              <% }); %>
            </select>
          </div>
        <% } %>
      </div>

      <!-- Address -->
      <div style="margin-bottom: 24px;">
        <label class="form-label" for="Address">Street Address</label>
        <textarea id="Address" name="Address" rows="2" class="form-control-crm" placeholder="Building, Street, Landmark..."><%= typeof data !== 'undefined' && data.Address ? data.Address : '' %></textarea>
      </div>

      <div style="display: flex; gap: 12px; justify-content: flex-end;">
        <a href="/customers" class="btn-crm btn-crm-secondary">Cancel</a>
        <button type="submit" class="btn-crm btn-crm-primary">
          <i class="fa-solid fa-save"></i>
          <span>Save Customer</span>
        </button>
      </div>
    </form>
  </div>
</div>
