<div style="max-width: 900px; margin: 0 auto;">
  <div style="margin-bottom: 20px;">
    <a href="/leads" style="color: var(--text-dim); text-decoration: none; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 6px;">
      <i class="fa-solid fa-arrow-left"></i>
      <span>Back to Leads</span>
    </a>
  </div>

  <div class="glass-card">
    <div class="card-header-flex">
      <div>
        <h2 style="font-size: 1.3rem; font-weight: 800; color: #fff; margin: 0 0 4px;">Capture New Lead</h2>
        <p style="margin: 0; font-size: 0.85rem; color: var(--text-muted);">Record prospective customer details and sales opportunity value</p>
      </div>
      <span style="font-size: 0.75rem; color: var(--text-dim);"><i class="fa-solid fa-asterisk text-danger"></i> Required fields</span>
    </div>

    <form action="/leads/create" method="POST" class="needs-crm-validation">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 20px;">
        <!-- Lead Name -->
        <div>
          <label class="form-label" for="LeadName">Lead Contact Name <span class="text-danger">*</span></label>
          <input type="text" id="LeadName" name="LeadName" class="form-control-crm" placeholder="Sarah Jenkins" value="<%= typeof data !== 'undefined' && data.LeadName ? data.LeadName : '' %>" required maxlength="100" data-name="Lead Name">
        </div>

        <!-- Company Name -->
        <div>
          <label class="form-label" for="CompanyName">Company Name</label>
          <input type="text" id="CompanyName" name="CompanyName" class="form-control-crm" placeholder="Starlight Media Ltd" value="<%= typeof data !== 'undefined' && data.CompanyName ? data.CompanyName : '' %>">
        </div>

        <!-- Email -->
        <div>
          <label class="form-label" for="Email">Email Address <span class="text-danger">*</span></label>
          <input type="email" id="Email" name="Email" class="form-control-crm" placeholder="sjenkins@starlight.io" value="<%= typeof data !== 'undefined' && data.Email ? data.Email : '' %>" required data-name="Email">
        </div>

        <!-- Phone -->
        <div>
          <label class="form-label" for="Phone">Mobile Phone (10 Digits) <span class="text-danger">*</span></label>
          <input type="text" id="Phone" name="Phone" class="form-control-crm" placeholder="9812345678" value="<%= typeof data !== 'undefined' && data.Phone ? data.Phone : '' %>" required data-type="phone" data-name="Phone">
        </div>

        <!-- Source -->
        <div>
          <label class="form-label" for="Source">Lead Source</label>
          <select id="Source" name="Source" class="form-control-crm">
            <option value="Website" selected>Website</option>
            <option value="Referral">Referral</option>
            <option value="Cold Call">Cold Call</option>
            <option value="Advertisement">Advertisement</option>
            <option value="Partner">Partner</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <!-- Status -->
        <div>
          <label class="form-label" for="Status">Lead Status</label>
          <select id="Status" name="Status" class="form-control-crm">
            <option value="New" selected>New</option>
            <option value="Contacted">Contacted</option>
            <option value="Qualified">Qualified</option>
            <option value="Unqualified">Unqualified</option>
            <option value="Lost">Lost</option>
          </select>
        </div>

        <!-- Priority -->
        <div>
          <label class="form-label" for="Priority">Priority</label>
          <select id="Priority" name="Priority" class="form-control-crm">
            <option value="Low">Low</option>
            <option value="Medium" selected>Medium</option>
            <option value="High">High</option>
          </select>
        </div>

        <!-- Expected Value -->
        <div>
          <label class="form-label" for="ExpectedValue">Estimated Deal Value ($)</label>
          <input type="number" id="ExpectedValue" name="ExpectedValue" class="form-control-crm" placeholder="50000" min="0" step="1000" value="<%= typeof data !== 'undefined' && data.ExpectedValue ? data.ExpectedValue : '25000' %>">
        </div>

        <!-- Assigned To -->
        <% if (currentUser && (currentUser.role === 'Admin' || currentUser.role === 'Manager')) { %>
          <div>
            <label class="form-label" for="AssignedTo">Assigned Sales Executive</label>
            <select id="AssignedTo" name="AssignedTo" class="form-control-crm">
              <% salesUsers.forEach(u => { %>
                <option value="<%= u.UserId %>" <%= (typeof data !== 'undefined' && data.AssignedTo == u.UserId) ? 'selected' : '' %>>
                  <%= u.Name %> (<%= u.Email %>)
                </option>
              <% }); %>
            </select>
          </div>
        <% } %>
      </div>

      <!-- Notes -->
      <div style="margin-bottom: 24px;">
        <label class="form-label" for="Notes">Discovery & Qualification Notes</label>
        <textarea id="Notes" name="Notes" rows="3" class="form-control-crm" placeholder="Key pain points, timeline, decision makers..."><%= typeof data !== 'undefined' && data.Notes ? data.Notes : '' %></textarea>
      </div>

      <div style="display: flex; gap: 12px; justify-content: flex-end;">
        <a href="/leads" class="btn-crm btn-crm-secondary">Cancel</a>
        <button type="submit" class="btn-crm btn-crm-primary">
          <i class="fa-solid fa-save"></i>
          <span>Save Lead</span>
        </button>
      </div>
    </form>
  </div>
</div>
