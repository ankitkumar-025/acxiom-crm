<div style="max-width: 900px; margin: 0 auto;">
  <div style="margin-bottom: 20px;">
    <a href="/leads/<%= lead.LeadId %>" style="color: var(--text-dim); text-decoration: none; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 6px;">
      <i class="fa-solid fa-arrow-left"></i>
      <span>Back to Lead Details</span>
    </a>
  </div>

  <div class="glass-card">
    <div class="card-header-flex">
      <div>
        <h2 style="font-size: 1.3rem; font-weight: 800; color: #fff; margin: 0 0 4px;">Edit Lead: <%= lead.LeadName %></h2>
        <p style="margin: 0; font-size: 0.85rem; color: var(--text-muted);"><%= lead.LeadCode %></p>
      </div>
    </div>

    <form action="/leads/<%= lead.LeadId %>/edit" method="POST" class="needs-crm-validation">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 20px;">
        <div>
          <label class="form-label" for="LeadName">Lead Name <span class="text-danger">*</span></label>
          <input type="text" id="LeadName" name="LeadName" class="form-control-crm" value="<%= lead.LeadName %>" required maxlength="100" data-name="Lead Name">
        </div>

        <div>
          <label class="form-label" for="CompanyName">Company</label>
          <input type="text" id="CompanyName" name="CompanyName" class="form-control-crm" value="<%= lead.CompanyName || '' %>">
        </div>

        <div>
          <label class="form-label" for="Email">Email Address <span class="text-danger">*</span></label>
          <input type="email" id="Email" name="Email" class="form-control-crm" value="<%= lead.Email %>" required data-name="Email">
        </div>

        <div>
          <label class="form-label" for="Phone">Phone (10 Digits) <span class="text-danger">*</span></label>
          <input type="text" id="Phone" name="Phone" class="form-control-crm" value="<%= lead.Phone %>" required data-type="phone" data-name="Phone">
        </div>

        <div>
          <label class="form-label" for="Source">Source</label>
          <select id="Source" name="Source" class="form-control-crm">
            <% ['Website', 'Referral', 'Cold Call', 'Advertisement', 'Partner', 'Other'].forEach(s => { %>
              <option value="<%= s %>" <%= lead.Source === s ? 'selected' : '' %>><%= s %></option>
            <% }); %>
          </select>
        </div>

        <div>
          <label class="form-label" for="Status">Status</label>
          <select id="Status" name="Status" class="form-control-crm">
            <% ['New', 'Contacted', 'Qualified', 'Unqualified', 'Converted', 'Lost'].forEach(st => { %>
              <option value="<%= st %>" <%= lead.Status === st ? 'selected' : '' %>><%= st %></option>
            <% }); %>
          </select>
        </div>

        <div>
          <label class="form-label" for="Priority">Priority</label>
          <select id="Priority" name="Priority" class="form-control-crm">
            <% ['Low', 'Medium', 'High'].forEach(p => { %>
              <option value="<%= p %>" <%= lead.Priority === p ? 'selected' : '' %>><%= p %></option>
            <% }); %>
          </select>
        </div>

        <div>
          <label class="form-label" for="ExpectedValue">Estimated Deal Value ($)</label>
          <input type="number" id="ExpectedValue" name="ExpectedValue" class="form-control-crm" min="0" value="<%= lead.ExpectedValue %>">
        </div>

        <% if (currentUser && (currentUser.role === 'Admin' || currentUser.role === 'Manager')) { %>
          <div>
            <label class="form-label" for="AssignedTo">Assigned Owner</label>
            <select id="AssignedTo" name="AssignedTo" class="form-control-crm">
              <% salesUsers.forEach(u => { %>
                <option value="<%= u.UserId %>" <%= lead.AssignedTo == u.UserId ? 'selected' : '' %>>
                  <%= u.Name %> (<%= u.Email %>)
                </option>
              <% }); %>
            </select>
          </div>
        <% } %>
      </div>

      <div style="margin-bottom: 24px;">
        <label class="form-label" for="Notes">Notes</label>
        <textarea id="Notes" name="Notes" rows="3" class="form-control-crm"><%= lead.Notes || '' %></textarea>
      </div>

      <div style="display: flex; gap: 12px; justify-content: flex-end;">
        <a href="/leads/<%= lead.LeadId %>" class="btn-crm btn-crm-secondary">Cancel</a>
        <button type="submit" class="btn-crm btn-crm-primary">
          <i class="fa-solid fa-check"></i>
          <span>Save Changes</span>
        </button>
      </div>
    </form>
  </div>
</div>
